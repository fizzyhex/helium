+gfx::Rect PinnedTabContainerView::GetDraggingViewsClampingBounds() const {
+  // Unlike the unpinned container, this one already leaves out the side
+  // padding of the tab strip, and its pins stay within its outline.
+  const auto* scroll_view = GetScrollViewForContainer();
+  CHECK(scroll_view);
+  gfx::Rect clamping_bounds = views::View::ConvertRectToTarget(
+      scroll_view, this, scroll_view->GetLocalBounds());
+  clamping_bounds.Inset(GetInsets());
+  // The squashed drag layout is wider than the dragged pin, which would
+  // otherwise stop short of the end of a row.
+  if (orientation_ == TabStripOrientation::kVertical) {
+    clamping_bounds.set_width(clamping_bounds.width() +
+                              kSquashedDragHorizontalPadding);
+  }
+  return clamping_bounds;
+}
