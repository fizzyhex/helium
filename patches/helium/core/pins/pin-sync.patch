+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_HELIUM_PINS_SYNC_H_
+#define CHROME_BROWSER_UI_TABS_HELIUM_PINS_SYNC_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection_observer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class GlobalBrowserCollection;
+class Profile;
+class TabStripModel;
+
+namespace helium_pins {
+
+class HeliumPinsTabController;
+
+// Keeps the pinned tabs of a profile's normal windows in sync with its pin
+// list. Each window has its own tab per pin; missing ones are added unloaded.
+// The list is saved on every change, except for off-the-record profiles.
+class HeliumPinsSync : public BrowserCollectionObserver,
+                       public TabStripModelObserver {
+ public:
+  explicit HeliumPinsSync(Profile* profile);
+  HeliumPinsSync(const HeliumPinsSync&) = delete;
+  HeliumPinsSync& operator=(const HeliumPinsSync&) = delete;
+  ~HeliumPinsSync() override;
+
+ private:
+  struct Pin {
+    std::string id;
+    GURL url;
+    // The id of the first pin of the split that this pin is part of, if any.
+    std::string split;
+    split_tabs::SplitTabVisualData split_visual_data;
+  };
+
+  // A window whose last unpinned tabs were dragged out while no pin was loaded.
+  struct WindowLeftWithoutTabs {
+    base::WeakPtr<BrowserWindowInterface> browser;
+    std::vector<tabs::TabHandle> tabs;
+  };
+
+  // A pin that was dragged or moved out of its window.
+  struct DepartedPin {
+    tabs::TabHandle tab;
+    base::WeakPtr<BrowserWindowInterface> source;
+    std::string id;
+  };
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabWillBeRemoved(tabs::TabInterface* tab, int index) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void OnSplitTabChanged(const SplitTabChange& change) override;
+
+  // Returns whether `browser` is a normal window of the profile.
+  bool IsSyncedBrowser(BrowserWindowInterface* browser);
+  // Returns whether the pins of `browser` can be changed right now.
+  bool IsReady(BrowserWindowInterface* browser);
+  std::vector<BrowserWindowInterface*> GetSyncedBrowsers();
+  // Returns the tabs of the pin `id` in all synced windows.
+  std::vector<HeliumPinsTabController*> GetPinTabs(const std::string& id);
+
+  std::vector<Pin>::iterator FindPin(const std::string& id);
+
+  // Reads the stored pin list.
+  void LoadPins();
+  // Reads which pins are split from the stored pin list.
+  void LoadSplits();
+  void SavePins();
+
+  // Handles the user pinning or unpinning `tab` in `browser`.
+  void AddPin(BrowserWindowInterface* browser, tabs::TabInterface* tab);
+  void RemovePin(tabs::TabInterface* tab);
+  // Removes the pin `id` from the pin list and closes its tabs.
+  void UnpinEverywhere(const std::string& id);
+  // Turns pins that left their window into regular tabs, unless they were
+  // dropped among the pins of another window.
+  void HandleDepartedPins();
+  // Adds or removes the pins of tabs that were pinned or unpinned by a drag.
+  void HandleDraggedPinChanges();
+  // Closes the windows that were left with only unloaded pins after a drag,
+  // unless tabs were dragged back into them.
+  void CloseWindowsLeftWithoutTabs();
+  // Takes the order of the pins in `browser` after the user moved one.
+  void ReorderPins(BrowserWindowInterface* browser);
+  // Returns the pin list position for a new pin `tab` in `browser`, right
+  // after the pin preceding it there.
+  size_t GetNewPinPosition(BrowserWindowInterface* browser,
+                           tabs::TabInterface* tab);
+
+  // Posts a Reconcile() of `browser`, after `delay` if given. Without
+  // `browser`, only retries handling the results of a drag.
+  void ScheduleReconcile(BrowserWindowInterface* browser,
+                         base::TimeDelta delay = base::TimeDelta());
+  void ScheduleReconcileOthers(BrowserWindowInterface* source);
+  void ReconcilePending();
+  // Makes the pinned tabs of `browser` match the pin list.
+  void Reconcile(BrowserWindowInterface* browser);
+  // Takes the pinned splits of `browser` into the pin list. Returns whether
+  // the pin list changed.
+  bool UpdateSplits(BrowserWindowInterface* browser);
+  // Splits and unsplits the pins of `browser` to match the pin list.
+  void ReconcileSplits(BrowserWindowInterface* browser);
+  // Adds a dormant tab for `pin` at `index` of `browser`.
+  void InsertDormantPin(BrowserWindowInterface* browser,
+                        int index,
+                        const Pin& pin);
+
+  const raw_ptr<Profile> profile_;
+
+  std::vector<Pin> pins_;
+
+  // True while this class modifies tab strips itself.
+  bool applying_changes_ = false;
+
+  std::vector<DepartedPin> departed_pins_;
+
+  // Tabs that were pinned or unpinned during a drag.
+  std::vector<tabs::TabHandle> dragged_pin_changes_;
+
+  // The loaded pins of the tab strip that tabs are being removed from.
+  raw_ptr<TabStripModel> removing_from_ = nullptr;
+  std::vector<tabs::TabHandle> loaded_pins_before_removal_;
+
+  std::vector<WindowLeftWithoutTabs> windows_left_without_tabs_;
+
+  std::vector<base::WeakPtr<BrowserWindowInterface>> pending_reconciles_;
+  bool reconcile_scheduled_ = false;
+
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browser_collection_observation_{this};
+
+  base::WeakPtrFactory<HeliumPinsSync> weak_factory_{this};
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_SYNC_H_
