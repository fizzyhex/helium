+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <utility>
+
+#include "base/auto_reset.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tab_list/tab_removed_reason.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_tabrestore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/helium_pins_tab_controller.h"
+#include "chrome/browser/ui/tabs/helium_pins_util.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/serialized_user_agent_override.h"
+#include "components/split_tabs/split_tab_id.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "url/url_constants.h"
+
+namespace helium_pins {
+
+namespace {
+
+// Keys of the pinned tabs preference entries. "url" is shared with
+// PinnedTabCodec, which still reads the list to open pins at startup.
+constexpr char kUrlKey[] = "url";
+constexpr char kIdKey[] = "id";
+constexpr char kSplitKey[] = "split";
+constexpr char kSplitLayoutKey[] = "split_layout";
+constexpr char kSplitRatioKey[] = "split_ratio";
+constexpr char kStackedLayout[] = "stacked";
+
+// Retry delay for windows that can't be changed yet, e.g. during a tab drag.
+constexpr base::TimeDelta kReconcileRetryDelay = base::Milliseconds(250);
+
+std::string CreatePinId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+GURL GetNewPinUrl(content::WebContents* contents) {
+  const GURL url = GetPinnableUrl(contents);
+  return url.is_valid() ? url : GURL(url::kAboutBlankURL);
+}
+
+// Returns the controllers of the pinned tabs of `browser`, in tab strip order.
+std::vector<HeliumPinsTabController*> GetPinnedTabControllers(
+    BrowserWindowInterface* browser) {
+  std::vector<HeliumPinsTabController*> controllers;
+  TabStripModel* const model = browser->GetTabStripModel();
+  for (int index = 0; index < model->IndexOfFirstNonPinnedTab(); ++index) {
+    if (HeliumPinsTabController* controller =
+            HeliumPinsTabController::From(model->GetTabAtIndex(index))) {
+      controllers.push_back(controller);
+    }
+  }
+  return controllers;
+}
+
+// Returns whether `tab` is a better copy of a pin to keep than `other`: the
+// one the user is looking at, or else one that is loaded.
+bool IsPreferredCopy(tabs::TabInterface* tab, tabs::TabInterface* other) {
+  if (tab->IsActivated() != other->IsActivated()) {
+    return tab->IsActivated();
+  }
+  return IsUnloaded(other->GetContents()) && !IsUnloaded(tab->GetContents());
+}
+
+// Returns whether `index` is between the two halves of a split.
+bool IsInsideSplit(TabStripModel* model, int index) {
+  if (index <= 0 || index >= model->count()) {
+    return false;
+  }
+  const std::optional<split_tabs::SplitTabId> split =
+      model->GetTabAtIndex(index)->GetSplit();
+  return split.has_value() &&
+         model->GetTabAtIndex(index - 1)->GetSplit() == split;
+}
+
+}  // namespace
+
+HeliumPinsSync::HeliumPinsSync(Profile* profile) : profile_(profile) {
+  // Off-the-record profiles start without pins.
+  if (!profile_->IsOffTheRecord()) {
+    LoadPins();
+    LoadSplits();
+  }
+
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [this](BrowserWindowInterface* browser) {
+        OnBrowserCreated(browser);
+        return true;
+      });
+  browser_collection_observation_.Observe(
+      GlobalBrowserCollection::GetInstance());
+}
+
+HeliumPinsSync::~HeliumPinsSync() = default;
+
+void HeliumPinsSync::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (!IsSyncedBrowser(browser)) {
+    return;
+  }
+
+  browser->GetTabStripModel()->AddObserver(this);
+  // Deferred, so that pins opened by startup or session restore are matched
+  // instead of duplicated.
+  ScheduleReconcile(browser);
+}
+
+void HeliumPinsSync::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  std::vector<tabs::TabHandle> loaded_pins_before_removal;
+  if (change.type() == TabStripModelChange::kRemoved &&
+      removing_from_ == tab_strip_model) {
+    removing_from_ = nullptr;
+    std::swap(loaded_pins_before_removal, loaded_pins_before_removal_);
+  }
+
+  BrowserWindowInterface* const browser =
+      tab_strip_model->delegate()->GetBrowserWindowInterface();
+  if (applying_changes_ || !IsSyncedBrowser(browser) ||
+      tab_strip_model->closing_all() ||
+      browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+
+  switch (change.type()) {
+    case TabStripModelChange::kInserted: {
+      // Pins can arrive from session restore, other windows or extensions.
+      if (std::ranges::any_of(
+              change.GetInsert()->contents,
+              [](const auto& inserted) { return inserted.tab->IsPinned(); })) {
+        ScheduleReconcile(browser);
+      }
+      break;
+    }
+    case TabStripModelChange::kRemoved: {
+      bool removed_pin = false;
+      std::vector<tabs::TabHandle> dragged_out;
+      for (const auto& removed : change.GetRemove()->contents) {
+        const tabs::TabHandle handle = removed.tab->GetHandle();
+        const bool is_dragged_out =
+            removed.remove_reason ==
+            TabRemovedReason::kInsertedIntoOtherTabStrip;
+        if (is_dragged_out) {
+          dragged_out.push_back(handle);
+        }
+
+        HeliumPinsTabController* const controller =
+            HeliumPinsTabController::From(removed.tab);
+        if (!controller || controller->pin_id().empty()) {
+          continue;
+        }
+        removed_pin = true;
+        // Where a pin that leaves the window ends up is only known once the
+        // drag is done, see HandleDepartedPins().
+        if (is_dragged_out &&
+            !std::ranges::contains(departed_pins_, handle, &DepartedPin::tab)) {
+          departed_pins_.push_back(
+              {handle, browser->GetWeakPtr(), controller->pin_id()});
+        }
+      }
+      // Closed or moved-away pins are replaced with a dormant copy.
+      if (removed_pin) {
+        ScheduleReconcile(browser);
+      }
+
+      // Like closing them, dragging out the last unpinned tabs of a window
+      // without loaded pins closes the window.
+      const bool has_loaded_pins = std::ranges::any_of(
+          loaded_pins_before_removal,
+          [tab_strip_model](tabs::TabHandle handle) {
+            tabs::TabInterface* const tab = handle.Get();
+            return tab &&
+                   tab_strip_model->GetIndexOfTab(tab) != TabStripModel::kNoTab;
+          });
+      if (!dragged_out.empty() && !has_loaded_pins &&
+          !tab_strip_model->empty() &&
+          tab_strip_model->IndexOfFirstNonPinnedTab() ==
+              tab_strip_model->count()) {
+        windows_left_without_tabs_.push_back(
+            {browser->GetWeakPtr(), std::move(dragged_out)});
+        ScheduleReconcile(browser);
+      }
+      break;
+    }
+    case TabStripModelChange::kMoved: {
+      if (IsPersistentPin(change.GetMove()->tab)) {
+        ReorderPins(browser);
+      }
+      break;
+    }
+    case TabStripModelChange::kReplaced:
+    case TabStripModelChange::kSelectionOnly:
+      break;
+  }
+}
+
+void HeliumPinsSync::OnTabWillBeRemoved(tabs::TabInterface* tab, int index) {
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  // Several tabs can be removed at once, so only look before the first one.
+  if (applying_changes_ || !IsSyncedBrowser(browser) ||
+      removing_from_ == browser->GetTabStripModel()) {
+    return;
+  }
+
+  removing_from_ = browser->GetTabStripModel();
+  loaded_pins_before_removal_.clear();
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    if (!IsUnloaded(controller->tab().GetContents())) {
+      loaded_pins_before_removal_.push_back(controller->tab().GetHandle());
+    }
+  }
+}
+
+void HeliumPinsSync::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                             int index) {
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  if (applying_changes_ || !IsSyncedBrowser(browser)) {
+    return;
+  }
+
+  // Drags pin and unpin tabs as they move them around, so the pin list only
+  // changes once the drag is done.
+  if (!IsReady(browser)) {
+    if (!std::ranges::contains(dragged_pin_changes_, tab->GetHandle())) {
+      dragged_pin_changes_.push_back(tab->GetHandle());
+    }
+    ScheduleReconcile(browser, kReconcileRetryDelay);
+    return;
+  }
+
+  if (tab->IsPinned()) {
+    AddPin(browser, tab);
+  } else {
+    RemovePin(tab);
+  }
+}
+
+void HeliumPinsSync::OnSplitTabChanged(const SplitTabChange& change) {
+  BrowserWindowInterface* const browser =
+      change.model->delegate()->GetBrowserWindowInterface();
+  // Closing a window takes its splits apart, which the other windows keep.
+  if (applying_changes_ || !IsSyncedBrowser(browser) ||
+      change.model->closing_all() || browser->IsDeleteScheduled() ||
+      browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+
+  // Splits dragged between windows are handled once the drag is done.
+  switch (change.type) {
+    case SplitTabChange::Type::kAdded:
+      if (change.GetAddedChange()->reason() ==
+          SplitTabChange::SplitTabAddReason::kInsertedFromAnotherTabstrip) {
+        return;
+      }
+      break;
+    case SplitTabChange::Type::kRemoved:
+      if (change.GetRemovedChange()->reason() ==
+          SplitTabChange::SplitTabRemoveReason::kDetachedToAnotherTabstrip) {
+        return;
+      }
+      break;
+    case SplitTabChange::Type::kVisualsChanged:
+      if (change.GetVisualsChange()->is_intermediate()) {
+        return;
+      }
+      break;
+    case SplitTabChange::Type::kContentsChanged:
+      break;
+  }
+
+  if (UpdateSplits(browser)) {
+    SavePins();
+    ScheduleReconcileOthers(browser);
+  }
+}
+
+bool HeliumPinsSync::IsSyncedBrowser(BrowserWindowInterface* browser) {
+  return HasPersistentPins(browser) && browser->GetProfile() == profile_;
+}
+
+bool HeliumPinsSync::IsReady(BrowserWindowInterface* browser) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  return !model->empty() && !model->closing_all() &&
+         model->delegate()->IsTabStripEditable();
+}
+
+std::vector<BrowserWindowInterface*> HeliumPinsSync::GetSyncedBrowsers() {
+  std::vector<BrowserWindowInterface*> browsers;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [this, &browsers](BrowserWindowInterface* browser) {
+        if (IsSyncedBrowser(browser) && !browser->IsDeleteScheduled()) {
+          browsers.push_back(browser);
+        }
+        return true;
+      });
+  return browsers;
+}
+
+std::vector<HeliumPinsTabController*> HeliumPinsSync::GetPinTabs(
+    const std::string& id) {
+  std::vector<HeliumPinsTabController*> pin_tabs;
+  for (BrowserWindowInterface* browser : GetSyncedBrowsers()) {
+    for (HeliumPinsTabController* controller :
+         GetPinnedTabControllers(browser)) {
+      if (controller->pin_id() == id) {
+        pin_tabs.push_back(controller);
+      }
+    }
+  }
+  return pin_tabs;
+}
+
+std::vector<HeliumPinsSync::Pin>::iterator HeliumPinsSync::FindPin(
+    const std::string& id) {
+  return std::ranges::find(pins_, id, &Pin::id);
+}
+
+void HeliumPinsSync::LoadPins() {
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(prefs::kPinnedTabs)) {
+    const base::DictValue* const dict = value.GetIfDict();
+    const std::string* const url = dict ? dict->FindString(kUrlKey) : nullptr;
+    if (!url) {
+      continue;
+    }
+    const std::string* const id = dict->FindString(kIdKey);
+    if (id && !id->empty() && FindPin(*id) == pins_.end()) {
+      pins_.push_back({*id, GURL(*url)});
+    }
+  }
+}
+
+void HeliumPinsSync::LoadSplits() {
+  for (const base::Value& value :
+       profile_->GetPrefs()->GetList(prefs::kPinnedTabs)) {
+    const base::DictValue* const dict = value.GetIfDict();
+    const std::string* const id = dict ? dict->FindString(kIdKey) : nullptr;
+    const std::string* const split =
+        dict ? dict->FindString(kSplitKey) : nullptr;
+    const auto it = id && split ? FindPin(*id) : pins_.end();
+    if (it == pins_.end()) {
+      continue;
+    }
+    it->split = *split;
+    const std::string* const layout = dict->FindString(kSplitLayoutKey);
+    it->split_visual_data = split_tabs::SplitTabVisualData(
+        layout && *layout == kStackedLayout
+            ? split_tabs::SplitTabLayout::kStacked
+            : split_tabs::SplitTabLayout::kSideBySide,
+        dict->FindDouble(kSplitRatioKey).value_or(0.5));
+  }
+}
+
+void HeliumPinsSync::SavePins() {
+  if (profile_->IsOffTheRecord()) {
+    return;
+  }
+
+  base::ListValue values;
+  for (const Pin& pin : pins_) {
+    base::DictValue value =
+        base::DictValue().Set(kUrlKey, pin.url.spec()).Set(kIdKey, pin.id);
+    if (!pin.split.empty()) {
+      value.Set(kSplitKey, pin.split);
+      if (pin.split_visual_data.split_layout() ==
+          split_tabs::SplitTabLayout::kStacked) {
+        value.Set(kSplitLayoutKey, kStackedLayout);
+      }
+      value.Set(kSplitRatioKey, pin.split_visual_data.split_ratio());
+    }
+    values.Append(std::move(value));
+  }
+  PrefService* const prefs = profile_->GetPrefs();
+  prefs->SetList(prefs::kPinnedTabs, std::move(values));
+  // Membership changes are rare, so write them right away.
+  prefs->CommitPendingWrite();
+}
+
+void HeliumPinsSync::AddPin(BrowserWindowInterface* browser,
+                            tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller =
+      HeliumPinsTabController::From(tab);
+  if (!controller || FindPin(controller->pin_id()) != pins_.end()) {
+    return;
+  }
+
+  const Pin pin{CreatePinId(), GetNewPinUrl(tab->GetContents())};
+  pins_.insert(pins_.begin() + GetNewPinPosition(browser, tab), pin);
+  controller->SetPin(pin.id, pin.url);
+  // Splits are pinned as a whole.
+  UpdateSplits(browser);
+  SavePins();
+  ScheduleReconcileOthers(browser);
+}
+
+void HeliumPinsSync::RemovePin(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller =
+      HeliumPinsTabController::From(tab);
+  if (!controller || controller->pin_id().empty()) {
+    return;
+  }
+
+  const std::string id = controller->pin_id();
+  controller->ClearPin();
+  UnpinEverywhere(id);
+}
+
+void HeliumPinsSync::UnpinEverywhere(const std::string& id) {
+  const auto it = FindPin(id);
+  if (it == pins_.end()) {
+    return;
+  }
+  pins_.erase(it);
+  SavePins();
+
+  base::AutoReset<bool> applying_changes(&applying_changes_, true);
+  for (HeliumPinsTabController* copy : GetPinTabs(id)) {
+    copy->ClearPin();
+    // Rather than closing a window, its last tab becomes a regular tab.
+    TabStripModel* const model =
+        copy->tab().GetBrowserWindowInterface()->GetTabStripModel();
+    if (model->count() == 1) {
+      model->SetTabPinned(0, false);
+      continue;
+    }
+    copy->tab().Close();
+  }
+}
+
+void HeliumPinsSync::HandleDepartedPins() {
+  std::vector<DepartedPin> departed;
+  std::swap(departed, departed_pins_);
+  for (const DepartedPin& pin : departed) {
+    tabs::TabInterface* const tab = pin.tab.Get();
+    BrowserWindowInterface* const target =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    // The pin is still being dragged.
+    if (IsSyncedBrowser(target) && !IsReady(target)) {
+      departed_pins_.push_back(pin);
+      continue;
+    }
+
+    // Its window gets a copy of the pin again, unless it's unpinned below.
+    if (pin.source) {
+      ScheduleReconcile(pin.source.get());
+    }
+
+    // Pins that were closed or went back to their window stay pins.
+    if (!IsSyncedBrowser(target) || target == pin.source.get()) {
+      continue;
+    }
+
+    // A pin dropped among the pins of another window only moves there.
+    const auto is_copy_in_target = [&](HeliumPinsTabController* copy) {
+      return &copy->tab() != tab &&
+             copy->tab().GetBrowserWindowInterface() == target;
+    };
+    if (tab->IsPinned() &&
+        std::ranges::any_of(GetPinTabs(pin.id), is_copy_in_target)) {
+      continue;
+    }
+
+    // Anywhere else, e.g. in a new window, it becomes a regular tab.
+    HeliumPinsTabController::From(tab)->ClearPin();
+    if (tab->IsPinned()) {
+      base::AutoReset<bool> applying_changes(&applying_changes_, true);
+      TabStripModel* const model = target->GetTabStripModel();
+      model->SetTabPinned(model->GetIndexOfTab(tab), false);
+    }
+    UnpinEverywhere(pin.id);
+  }
+}
+
+void HeliumPinsSync::HandleDraggedPinChanges() {
+  std::vector<tabs::TabHandle> changes;
+  std::swap(changes, dragged_pin_changes_);
+  for (tabs::TabHandle handle : changes) {
+    tabs::TabInterface* const tab = handle.Get();
+    BrowserWindowInterface* const browser =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (!IsSyncedBrowser(browser)) {
+      continue;
+    }
+    if (!IsReady(browser)) {
+      dragged_pin_changes_.push_back(handle);
+    } else if (tab->IsPinned()) {
+      AddPin(browser, tab);
+    } else {
+      RemovePin(tab);
+    }
+  }
+}
+
+void HeliumPinsSync::CloseWindowsLeftWithoutTabs() {
+  // Tabs can still be dragged back while a drag is going on.
+  if (!std::ranges::all_of(GetSyncedBrowsers(), [this](auto* browser) {
+        return IsReady(browser);
+      })) {
+    return;
+  }
+
+  std::vector<WindowLeftWithoutTabs> windows;
+  std::swap(windows, windows_left_without_tabs_);
+  for (const WindowLeftWithoutTabs& window : windows) {
+    BrowserWindowInterface* const browser = window.browser.get();
+    if (!browser || browser->IsDeleteScheduled()) {
+      continue;
+    }
+    // The tabs may have come back later in the drag, e.g. to be pinned.
+    const bool tabs_returned =
+        std::ranges::any_of(window.tabs, [browser](tabs::TabHandle handle) {
+          tabs::TabInterface* const tab = handle.Get();
+          return tab && tab->GetBrowserWindowInterface() == browser;
+        });
+    TabStripModel* const model = browser->GetTabStripModel();
+    if (!tabs_returned && model->IndexOfFirstNonPinnedTab() == model->count()) {
+      chrome::CloseWindow(browser);
+    }
+  }
+}
+
+void HeliumPinsSync::ReorderPins(BrowserWindowInterface* browser) {
+  // Positions in the pin list of the pins in `browser`, and their new order.
+  std::vector<size_t> positions;
+  std::vector<Pin> reordered;
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    const auto it = FindPin(controller->pin_id());
+    // A pin can have two tabs in a window for a moment, e.g. while it's
+    // dragged back in, so only its first one counts.
+    if (it != pins_.end() &&
+        !std::ranges::contains(reordered, it->id, &Pin::id)) {
+      positions.push_back(it - pins_.begin());
+      reordered.push_back(*it);
+    }
+  }
+
+  // Pins missing from `browser` keep their positions.
+  std::ranges::sort(positions);
+  bool changed = false;
+  for (size_t i = 0; i < positions.size(); ++i) {
+    if (pins_[positions[i]].id != reordered[i].id) {
+      pins_[positions[i]] = std::move(reordered[i]);
+      changed = true;
+    }
+  }
+
+  if (changed) {
+    SavePins();
+    ScheduleReconcileOthers(browser);
+  }
+}
+
+size_t HeliumPinsSync::GetNewPinPosition(BrowserWindowInterface* browser,
+                                         tabs::TabInterface* tab) {
+  size_t position = 0;
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    if (&controller->tab() == tab) {
+      break;
+    }
+    const auto it = FindPin(controller->pin_id());
+    if (it != pins_.end()) {
+      position = it - pins_.begin() + 1;
+    }
+  }
+  return position;
+}
+
+void HeliumPinsSync::ScheduleReconcile(BrowserWindowInterface* browser,
+                                       base::TimeDelta delay) {
+  if (browser &&
+      !std::ranges::contains(pending_reconciles_, browser,
+                             &base::WeakPtr<BrowserWindowInterface>::get)) {
+    pending_reconciles_.push_back(browser->GetWeakPtr());
+  }
+  if (!reconcile_scheduled_) {
+    reconcile_scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&HeliumPinsSync::ReconcilePending,
+                       weak_factory_.GetWeakPtr()),
+        delay);
+  }
+}
+
+void HeliumPinsSync::ScheduleReconcileOthers(BrowserWindowInterface* source) {
+  for (BrowserWindowInterface* browser : GetSyncedBrowsers()) {
+    if (browser != source) {
+      ScheduleReconcile(browser);
+    }
+  }
+}
+
+void HeliumPinsSync::ReconcilePending() {
+  reconcile_scheduled_ = false;
+  if (browser_shutdown::HasShutdownStarted()) {
+    pending_reconciles_.clear();
+    return;
+  }
+
+  // Windows in the middle of a drag, which a dragged tab can pass through, are
+  // retried later. Tabs that the drag changed are handled once they are in a
+  // window that isn't.
+  std::vector<base::WeakPtr<BrowserWindowInterface>> pending;
+  std::swap(pending, pending_reconciles_);
+  HandleDepartedPins();
+  HandleDraggedPinChanges();
+  for (const base::WeakPtr<BrowserWindowInterface>& browser : pending) {
+    if (!browser || browser->IsDeleteScheduled() ||
+        !IsSyncedBrowser(browser.get())) {
+      continue;
+    }
+    if (IsReady(browser.get())) {
+      Reconcile(browser.get());
+    } else {
+      ScheduleReconcile(browser.get(), kReconcileRetryDelay);
+    }
+  }
+  CloseWindowsLeftWithoutTabs();
+
+  if (!departed_pins_.empty() || !dragged_pin_changes_.empty() ||
+      !windows_left_without_tabs_.empty()) {
+    ScheduleReconcile(nullptr, kReconcileRetryDelay);
+  }
+}
+
+void HeliumPinsSync::Reconcile(BrowserWindowInterface* browser) {
+  base::AutoReset<bool> applying_changes(&applying_changes_, true);
+  TabStripModel* const model = browser->GetTabStripModel();
+  bool pins_changed = false;
+
+  // Sort the pinned tabs of the window by their pin list entry.
+  std::map<std::string, HeliumPinsTabController*> present;
+  std::vector<HeliumPinsTabController*> unidentified;
+  std::vector<HeliumPinsTabController*> to_unpin;
+  std::vector<HeliumPinsTabController*> to_close;
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    const std::string& id = controller->pin_id();
+    if (id.empty()) {
+      unidentified.push_back(controller);
+    } else if (FindPin(id) == pins_.end()) {
+      // The pin was removed while this tab's window was closed.
+      to_unpin.push_back(controller);
+    } else if (auto it = present.find(id); it != present.end()) {
+      // A duplicate, e.g. dragged in from another window.
+      if (IsPreferredCopy(&controller->tab(), &it->second->tab())) {
+        to_close.push_back(std::exchange(it->second, controller));
+      } else {
+        to_close.push_back(controller);
+      }
+    } else {
+      present[id] = controller;
+    }
+  }
+
+  // Pins without an id, e.g. from startup or extensions, are matched by URL.
+  for (HeliumPinsTabController* controller : unidentified) {
+    content::WebContents* const contents = controller->tab().GetContents();
+    const GURL url = GetPinnableUrl(contents);
+    const auto match = std::ranges::find_if(pins_, [&](const Pin& pin) {
+      return pin.url == url && !present.contains(pin.id);
+    });
+    if (match != pins_.end()) {
+      controller->SetPin(match->id, match->url);
+      present[match->id] = controller;
+    } else {
+      const Pin pin{CreatePinId(), GetNewPinUrl(contents)};
+      const size_t position = GetNewPinPosition(browser, &controller->tab());
+      pins_.insert(pins_.begin() + position, pin);
+      controller->SetPin(pin.id, pin.url);
+      present[pin.id] = controller;
+      pins_changed = true;
+    }
+  }
+
+  for (HeliumPinsTabController* controller : to_close) {
+    controller->ClearPin();
+    controller->tab().Close();
+  }
+  for (HeliumPinsTabController* controller : to_unpin) {
+    controller->ClearPin();
+    const int index = model->GetIndexOfTab(&controller->tab());
+    if (index != TabStripModel::kNoTab && model->IsTabPinned(index)) {
+      model->SetTabPinned(index, false);
+    }
+  }
+
+  // Add missing pins and restore the shared order, unless moving tabs could
+  // break up a pinned split.
+  const bool has_pinned_split = std::ranges::any_of(
+      present, [](const auto& entry) { return entry.second->tab().IsSplit(); });
+  int next_index = 0;
+  for (const Pin& pin : pins_) {
+    const auto it = present.find(pin.id);
+    if (it == present.end()) {
+      // Pins that are being dragged around get their copy after the drag.
+      if (std::ranges::contains(departed_pins_, pin.id, &DepartedPin::id)) {
+        continue;
+      }
+      int index = std::min(next_index, model->IndexOfFirstNonPinnedTab());
+      if (IsInsideSplit(model, index)) {
+        ++index;
+      }
+      InsertDormantPin(browser, index, pin);
+      next_index = index + 1;
+      continue;
+    }
+
+    const int index = model->GetIndexOfTab(&it->second->tab());
+    if (!has_pinned_split && index != next_index) {
+      model->MoveWebContentsAt(index, next_index,
+                               /*select_after_move=*/false);
+      ++next_index;
+    } else {
+      next_index = index + 1;
+    }
+  }
+
+  ReconcileSplits(browser);
+
+  if (pins_changed) {
+    SavePins();
+    ScheduleReconcileOthers(browser);
+  }
+}
+
+bool HeliumPinsSync::UpdateSplits(BrowserWindowInterface* browser) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  // The first pin of each split in `browser`.
+  std::map<split_tabs::SplitTabId, std::string> first_pins;
+  bool changed = false;
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    const auto it = FindPin(controller->pin_id());
+    if (it == pins_.end()) {
+      continue;
+    }
+    std::string split;
+    split_tabs::SplitTabVisualData visual_data;
+    if (const std::optional<split_tabs::SplitTabId> split_id =
+            controller->tab().GetSplit()) {
+      split = first_pins.try_emplace(*split_id, it->id).first->second;
+      visual_data = *model->GetSplitData(*split_id)->visual_data();
+    }
+    if (it->split != split || it->split_visual_data != visual_data) {
+      it->split = std::move(split);
+      it->split_visual_data = visual_data;
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+void HeliumPinsSync::ReconcileSplits(BrowserWindowInterface* browser) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  std::map<std::string, tabs::TabInterface*> pin_tabs;
+  for (HeliumPinsTabController* controller : GetPinnedTabControllers(browser)) {
+    pin_tabs[controller->pin_id()] = &controller->tab();
+  }
+  const auto find_pin = [this](tabs::TabInterface* tab) -> const Pin* {
+    HeliumPinsTabController* const controller =
+        HeliumPinsTabController::From(tab);
+    const auto it = controller ? FindPin(controller->pin_id()) : pins_.end();
+    return it == pins_.end() ? nullptr : &*it;
+  };
+
+  // Unsplit pinned splits that aren't in the pin list, and update the others.
+  for (const split_tabs::SplitTabId& split_id : model->ListSplits()) {
+    split_tabs::SplitTabData* const data = model->GetSplitData(split_id);
+    const std::vector<tabs::TabInterface*> members = data->ListTabs();
+    if (!members.front()->IsPinned()) {
+      continue;
+    }
+    const Pin* const pin = find_pin(members.front());
+    if (!pin || pin->split.empty() ||
+        std::ranges::any_of(members, [&](tabs::TabInterface* tab) {
+          const Pin* const member_pin = find_pin(tab);
+          return !member_pin || member_pin->split != pin->split;
+        })) {
+      model->RemoveSplit(split_id);
+      continue;
+    }
+    const split_tabs::SplitTabVisualData& visual_data = pin->split_visual_data;
+    if (data->visual_data()->split_layout() != visual_data.split_layout()) {
+      model->UpdateSplitLayout(split_id, visual_data.split_layout());
+    }
+    if (data->visual_data()->split_ratio() != visual_data.split_ratio()) {
+      model->UpdateSplitRatio(split_id, visual_data.split_ratio());
+    }
+  }
+
+  // Split the pins that are split in the pin list.
+  for (size_t i = 0; i + 1 < pins_.size(); ++i) {
+    const Pin& first = pins_[i];
+    const Pin& second = pins_[i + 1];
+    if (first.split != first.id || second.split != first.id) {
+      continue;
+    }
+    tabs::TabInterface* const first_tab = pin_tabs[first.id];
+    tabs::TabInterface* const second_tab = pin_tabs[second.id];
+    if (!first_tab || !second_tab || first_tab->IsSplit() ||
+        second_tab->IsSplit()) {
+      continue;
+    }
+    std::vector<int> indices = {model->GetIndexOfTab(first_tab),
+                                model->GetIndexOfTab(second_tab)};
+    std::ranges::sort(indices);
+    model->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), indices,
+                        first.split_visual_data);
+  }
+}
+
+void HeliumPinsSync::InsertDormantPin(BrowserWindowInterface* browser,
+                                      int index,
+                                      const Pin& pin) {
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_index(0);
+  navigation.set_virtual_url(pin.url);
+
+  // Show the title of a loaded copy, if one is still at the pinned URL.
+  for (HeliumPinsTabController* copy : GetPinTabs(pin.id)) {
+    const content::NavigationEntry* const entry =
+        copy->tab().GetContents()->GetController().GetLastCommittedEntry();
+    if (entry && entry->GetURL() == pin.url) {
+      navigation.set_title(entry->GetTitle());
+    }
+  }
+
+  content::WebContents* const contents = chrome::AddRestoredTab(
+      browser, base::span_from_ref(navigation), index,
+      /*selected_navigation=*/0, /*extension_app_id=*/std::string(),
+      /*group=*/std::nullopt, /*select=*/false, /*pin=*/true,
+      /*last_active_time_ticks=*/base::TimeTicks(),
+      /*last_active_time=*/base::Time(), /*storage_namespace=*/nullptr,
+      /*user_agent_override=*/sessions::SerializedUserAgentOverride(),
+      /*extra_data=*/{}, /*from_session_restore=*/false,
+      /*is_active_browser=*/std::nullopt,
+      chrome::RestoredTabLoadPolicy::kDeferUntilActivation);
+
+  if (HeliumPinsTabController* controller = HeliumPinsTabController::From(
+          tabs::TabInterface::GetFromContents(contents))) {
+    controller->SetPin(pin.id, pin.url);
+  }
+}
