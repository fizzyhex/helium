+void CloseWindow(base::WeakPtr<BrowserWindowInterface> browser) {
+  if (browser) {
+    chrome::CloseWindow(browser.get());
+  }
+}
+
+// Returns the tab to activate instead of the `closing` ones: the most recently
+// used unpinned tab, else the most recently used loaded pin. Foreground tabs
+// are skipped, so the active split doesn't stay in front.
+tabs::TabInterface* FindReplacementTab(
+    TabStripModel* model,
+    const std::set<tabs::TabInterface*>& closing) {
+  // Unpinned tabs rank above pins, more recently used tabs above others.
+  auto rank = [](tabs::TabInterface* tab) {
+    return std::pair(!tab->IsPinned(),
+                     tab->GetContents()->GetLastActiveTimeTicks());
+  };
+
+  tabs::TabInterface* best = nullptr;
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(index);
+    if (closing.contains(tab) || model->IsTabInForeground(index) ||
+        model->IsTabCollapsed(index) ||
+        (tab->IsPinned() && IsUnloaded(tab->GetContents()))) {
+      continue;
+    }
+    if (!best || rank(tab) > rank(best)) {
+      best = tab;
+    }
+  }
+  return best;
+}
+
+// Hibernates a pin that was put away, unless it was unpinned or moved into the
+// foreground since then.
+void HibernateTab(tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!IsPersistentPin(tab) || IsUnloaded(tab->GetContents())) {
+    return;
+  }
+  TabStripModel* const model =
+      tab->GetBrowserWindowInterface()->GetTabStripModel();
+  model->HibernateTabAt(model->GetIndexOfTab(tab));
+}
+
+// Hibernates `tab` once it is no longer visible.
+void ScheduleHibernation(tabs::TabInterface* tab) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&HibernateTab, tab->GetHandle()));
+}
+
