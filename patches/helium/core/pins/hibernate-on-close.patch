+std::vector<tabs::TabHandle> HandleUserClosingTabs(
+    BrowserWindowInterface* browser,
+    std::vector<tabs::TabHandle> tab_handles) {
+  if (!HasPersistentPins(browser)) {
+    return tab_handles;
+  }
+
+  TabStripModel* const model = browser->GetTabStripModel();
+  std::set<tabs::TabInterface*> closing;
+  std::set<tabs::TabInterface*> pins;
+  for (tabs::TabHandle handle : tab_handles) {
+    tabs::TabInterface* const tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    closing.insert(tab);
+    if (!IsPersistentPin(tab)) {
+      continue;
+    }
+    pins.insert(tab);
+    // Splits are pinned as a whole, so they are also put away as a whole.
+    if (tab->IsSplit()) {
+      for (tabs::TabInterface* split_tab :
+           model->GetSplitData(tab->GetSplit().value())->ListTabs()) {
+        if (IsPersistentPin(split_tab)) {
+          closing.insert(split_tab);
+          pins.insert(split_tab);
+        }
+      }
+    }
+  }
+
+  // Check whether the last unpinned tabs are closed while pins stay.
+  const int first_unpinned = model->IndexOfFirstNonPinnedTab();
+  bool closes_last_unpinned =
+      first_unpinned > 0 && first_unpinned < model->count();
+  for (int index = first_unpinned; index < model->count(); ++index) {
+    closes_last_unpinned &= closing.contains(model->GetTabAtIndex(index));
+  }
+  if (pins.empty() && !closes_last_unpinned) {
+    return tab_handles;
+  }
+
+  std::erase_if(tab_handles, [&pins](tabs::TabHandle handle) {
+    return pins.contains(handle.Get());
+  });
+
+  // Activate another loaded tab before hibernating the pins. Dormant pins are
+  // never loaded for this: without a loaded tab, putting away the last loaded
+  // pin opens a New Tab, and closing the last unpinned tab closes the window.
+  tabs::TabInterface* const active = model->GetActiveTab();
+  if (active && closing.contains(active)) {
+    if (tabs::TabInterface* replacement = FindReplacementTab(model, closing)) {
+      model->ActivateTabAt(model->GetIndexOfTab(replacement));
+    } else if (!pins.empty()) {
+      chrome::AddTabAt(browser, GURL(), -1, /*foreground=*/true);
+    } else {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&CloseWindow, browser->GetWeakPtr()));
+      return {};
+    }
+  }
+
+  for (tabs::TabInterface* pin : pins) {
+    ScheduleHibernation(pin);
+  }
+
+  return tab_handles;
+}
+
 }  // namespace helium_pins
