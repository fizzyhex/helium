+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+#include "url/url_constants.h"
+
+namespace helium_pins {
+
+namespace {
+
+// Returns the controller of the tab navigated by `handle` if it is a
+// persistent pin.
+HeliumPinsTabController* GetNavigatedPinController(
+    content::NavigationHandle& handle) {
+  return GetPinController(
+      tabs::TabInterface::MaybeGetFromContents(handle.GetWebContents()));
+}
+
+// Returns whether `handle` returns to a page that was already in the tab.
+bool IsNavigationToExistingEntry(content::NavigationHandle& handle) {
+  return handle.IsHistory() ||
+         handle.GetReloadType() != content::ReloadType::NONE ||
+         handle.GetRestoreType() == content::RestoreType::kRestored;
+}
+
+// Returns whether `handle` should open outside of the pin at `pinned_url`.
+bool ShouldOpenOutsidePin(content::NavigationHandle& handle,
+                          const GURL& pinned_url) {
+  // Form submissions can't be repeated in another tab.
+  if (handle.IsPost() || IsNavigationToExistingEntry(handle)) {
+    return false;
+  }
+
+  // External protocols don't navigate the pin.
+  const GURL& url = handle.GetURL();
+  if (url.SchemeIs(url::kAboutScheme) || !ProfileIOData::IsHandledURL(url)) {
+    return false;
+  }
+
+  return !url::Origin::Create(pinned_url).IsSameOriginWith(url);
+}
+
+void ResetToPinnedUrl(tabs::TabHandle handle) {
+  if (HeliumPinsTabController* controller =
+          HeliumPinsTabController::From(handle.Get())) {
+    controller->ResetToPinnedUrl();
+  }
+}
+
+void OpenInNewTab(base::WeakPtr<content::WebContents> contents,
+                  content::OpenURLParams params) {
+  if (contents) {
+    contents->OpenURL(params, /*navigation_handle_callback=*/{});
+  }
+}
+
+}  // namespace
+
+// static
+void HeliumPinsNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (handle.IsInPrimaryMainFrame() && GetNavigatedPinController(handle)) {
+    registry.AddThrottle(
+        std::make_unique<HeliumPinsNavigationThrottle>(registry));
+  }
+}
+
+HeliumPinsNavigationThrottle::HeliumPinsNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+HeliumPinsNavigationThrottle::~HeliumPinsNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+HeliumPinsNavigationThrottle::WillStartRequest() {
+  content::NavigationHandle& handle = *navigation_handle();
+  HeliumPinsTabController* const controller = GetNavigatedPinController(handle);
+  if (!controller || !controller->pinned_url().is_valid()) {
+    return PROCEED;
+  }
+  const GURL& pinned_url = controller->pinned_url();
+
+  // Replace the reload of a reactivated pin's last page with its pinned URL.
+  if (controller->reset_on_activation() &&
+      IsNavigationToExistingEntry(handle) && handle.GetURL() != pinned_url) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ResetToPinnedUrl, controller->tab().GetHandle()));
+    return CANCEL_AND_IGNORE;
+  }
+
+  if (!ShouldOpenOutsidePin(handle, pinned_url)) {
+    return PROCEED;
+  }
+
+  // Keep the request's referrer, initiator and user gesture.
+  content::OpenURLParams params =
+      content::OpenURLParams::FromNavigationHandle(&handle);
+  params.frame_tree_node_id = content::FrameTreeNodeId();
+  params.disposition = WindowOpenDisposition::kNewForegroundTab;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&OpenInNewTab, handle.GetWebContents()->GetWeakPtr(),
+                     std::move(params)));
+  return CANCEL_AND_IGNORE;
+}
+
+const char* HeliumPinsNavigationThrottle::GetNameForLogging() {
+  return "HeliumPinsNavigationThrottle";
+}
+
+}  // namespace helium_pins
