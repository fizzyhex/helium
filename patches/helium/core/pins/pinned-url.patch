+  PinnedTabService* const service = PinnedTabServiceFactory::GetForProfile(
+      tab->GetBrowserWindowInterface()->GetProfile());
+  if (service) {
+    service->pins_sync()->SetPinnedUrl(controller->pin_id(), url);
+  } else {
+    controller->SetPinnedUrl(url);
+  }
+}
