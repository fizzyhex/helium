+bool CanReturnToPinnedUrl(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller = GetPinController(tab);
+  if (!controller || !controller->pinned_url().is_valid() ||
+      GetPinnableUrl(tab->GetContents()) == controller->pinned_url()) {
+    return false;
+  }
+  // An unloaded pin that was put away already returns on activation.
+  return !IsUnloaded(tab->GetContents()) || !controller->reset_on_activation();
+}
+
+void ReturnToPinnedUrl(tabs::TabInterface* tab) {
+  if (!CanReturnToPinnedUrl(tab)) {
+    return;
+  }
+
+  HeliumPinsTabController* const controller = GetPinController(tab);
+  if (IsUnloaded(tab->GetContents())) {
+    // Don't load a dormant tab in the background.
+    controller->SetResetOnActivation(true);
+  } else {
+    controller->ResetToPinnedUrl();
+  }
