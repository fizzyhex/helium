+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace helium_pins {
+
+// Opens navigations from a persistent pin to other origins in a new tab;
+// redirects stay in the pin. Also replaces the reload of a reactivated pin's
+// last page with its pinned URL.
+class HeliumPinsNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit HeliumPinsNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  HeliumPinsNavigationThrottle(const HeliumPinsNavigationThrottle&) = delete;
+  HeliumPinsNavigationThrottle& operator=(const HeliumPinsNavigationThrottle&) =
+      delete;
+  ~HeliumPinsNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace helium_pins
+
+#endif  // CHROME_BROWSER_UI_TABS_HELIUM_PINS_NAVIGATION_THROTTLE_H_
