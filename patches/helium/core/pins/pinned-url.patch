+
+bool CanUseCurrentUrlAsPinnedUrl(tabs::TabInterface* tab) {
+  HeliumPinsTabController* const controller = GetPinController(tab);
+  if (!controller) {
+    return false;
+  }
+  const GURL url = GetPinnableUrl(tab->GetContents());
+  return url.is_valid() && url != controller->pinned_url();
+}
+
+void UseCurrentUrlAsPinnedUrl(tabs::TabInterface* tab) {
+  if (!CanUseCurrentUrlAsPinnedUrl(tab)) {
+    return;
+  }
+
+  HeliumPinsTabController* const controller = GetPinController(tab);
+  const GURL url = GetPinnableUrl(tab->GetContents());
+  // The tab is at its new pinned URL, so there's nothing to return to.
+  controller->SetResetOnActivation(false);
